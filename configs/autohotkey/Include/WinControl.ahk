#Requires AutoHotkey v2.0

; Full Screen 
!Enter::F11

; Std Window Move
#h::#!Left
#j::#Down
#k::#Up
#l::#!Right

; Shift Window Zones
#+h::#!Left
#+j::#Left
#+k::#Right
#+l::#!Right

; Deprecated Use (Window Move)
#^h::#!Left
#^j::#!Down
#^k::#!Up
#^l::#!Right

; Minimise/Maximise
#+n::#Home
#n::#Home

; Full Screen 
!Enter::F11

; Close Window
#w::!F4
