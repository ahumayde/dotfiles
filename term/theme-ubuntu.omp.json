{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none",
            "style": "folder"
          },
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b0",
          "template": " \ue5ff {{ .Path }} ",
          "foreground": "#F9F1A5",
          "background": "#18354c",
          "type": "path",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "fetch_upstream_icon": true
          },
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4 ",
          "template": "{{ .UpstreamIcon }} {{ .HEAD }}",
          "foreground": "#7b44ff",
          "background": "#18354c",
          "type": "git",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "fetch_status": true
          },
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4 ",
          "template": "{{if or (gt .Ahead 0) (gt .Behind 0) }}{{ .BranchStatus }}{{ end }}",
          "background": "#18354c",
          "type": "git",
          "style": "diamond",
          "foreground_templates": [
            "{{ if gt .Behind 0 }}#D22A24{{ end }}",
            "{{ if gt .Ahead  0 }}#29FCBC{{ end }}"
          ]
        },
        {
          "properties": {
            "cache_duration": "none",
            "fetch_status": true
          },
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4 ",
          "template": "{{ if .Staging.Changed }}\uf046 {{ .Staging.String }}{{ end }}",
          "foreground": "#00ff00",
          "background": "#18354c",
          "type": "git",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "fetch_status": true
          },
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4 ",
          "template": "{{ if .Working.Changed }}\uf044 {{ .Working.String }}{{ end }}",
          "foreground": "#ff2222",
          "background": "#18354c",
          "type": "git",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "fetch_stash_count": true
          },
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4 ",
          "template": "{{ if gt .StashCount 0 }}\ueb4b {{ .StashCount }}{{ end }}",
          "foreground": "#D75CFF",
          "background": "#18354c",
          "type": "git",
          "style": "diamond"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [ {
          "properties": {
            "cache_duration": "none",
            "charged_icon": "\uf240 ",
            "charging_icon": "\uf1e6 ",
            "discharging_icon": "\ue234 "
          },
          "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }}\uf295 <#262626></>",
          "foreground": "#33dd2d",
          "type": "battery",
          "style": "diamond",
          "trailing_diamond": "\ue0b6",
          "foreground_templates": [
            "{{if eq \"Charging\" .State.String}}#b8e994{{end}}",
            "{{if eq \"Discharging\" .State.String}}#fff34e{{end}}",
            "{{if eq \"Full\" .State.String}}#33DD2D{{end}}"
          ]
        }, {
          "properties": {
            "cache_duration": "none",
            "linux": "\ue712",
            "macos": "\ue711",
            "windows": "\ue70f"
          },
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "<#002030,#18354c>\ue0b2",
          "template": " {{.Icon}} </>",
          "foreground": "#F9F1A5",
          "background": "#18354c",
          "type": "os",
          "style": "diamond"
        }, {
          "properties": {
            "cache_duration": "none",
            "time_format": "_2,15:04"
          },
          "leading_diamond": "<#18354c,#002030>\ue0b2",
          "trailing_diamond": "\ue0b4",
          "template": " \uf073 {{ .CurrentDate | date .Format }} ",
          "foreground": "#F9F1A5",
          "background": "#18354c",
          "type": "time",
          "style": "diamond"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "always_enabled": true,
            "cache_duration": "none"
          },
          "template": "> ",
          "foreground": "#e0f8ff",
          "type": "status",
          "style": "plain"
        }
      ],
      "newline": true
    }
  ],
  "version": 3
}
